    "express": "^5.3.0",
    "node-cache": "^5.1.2",
    "papaparse": "^5.5.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/papaparse": "^5.3.16",
    "prisma": "^6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
